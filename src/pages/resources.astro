---
import Layout from '../layouts/Layout.astro';

// Helper function to create proper asset URLs
const getAssetUrl = (path: string) => {
  const base = import.meta.env.BASE_URL;
  return base.endsWith('/') ? `${base}${path}` : `${base}/${path}`;
};
---

<Layout title="Resources - Maps & Downloads | The Secret Harmony" description="Download high-resolution maps and resources from the world of I'lyr">
  <!-- Hero Section -->
  <section class="relative py-12 overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-r from-slate-900/90 to-emerald-900/80"></div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center">
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-emerald-400 mb-6 font-['Cinzel']">
          Resources & Downloads
        </h1>
        <p class="text-xl md:text-2xl text-slate-300 max-w-3xl mx-auto">
          Enhance your reading experience with downloadable maps, guides, and reference materials from the world of I'lyr.
        </p>
      </div>
    </div>
  </section>

  <!-- World Map Section -->
  <section class="py-20 bg-slate-800/50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-3xl md:text-4xl font-bold text-emerald-400 mb-4 font-['Cinzel']">
          Map of I'lyr
        </h2>
        <p class="text-xl text-slate-300 max-w-3xl mx-auto">
          Download the complete map of I'lyr to reference while reading, print for your book club, or simply enjoy as a visual companion to your journey through the Five Arbories.
        </p>
      </div>

      <div class="grid lg:grid-cols-2 gap-12 items-start">
        <!-- Map Preview -->
        <div class="relative">
          <div class="overflow-hidden rounded-lg border-2 border-emerald-800/30 bg-slate-900/30 p-4">
            <img
              src={getAssetUrl('images/ilyr-prime.jpg')}
              alt="Map of I'lyr showing the Five Arbories and key settlements"
              class="w-full h-auto rounded-lg shadow-2xl"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-slate-900/40 to-transparent pointer-events-none rounded-lg"></div>
          </div>
        </div>

        <!-- Download Options -->
        <div class="space-y-6">
          <div class="bg-slate-900/50 p-8 rounded-lg border border-emerald-800/30">
            <h3 class="text-2xl font-semibold text-emerald-400 mb-6 font-['Cinzel']">Available Formats</h3>

            <!-- Digital Version -->
            <div class="mb-8 pb-8 border-b border-emerald-800/30">
              <div class="flex items-start mb-4">
                <span class="text-3xl mr-4">🖥️</span>
                <div class="flex-1">
                  <h4 class="text-xl font-semibold text-emerald-300 mb-2">Digital Version</h4>
                  <p class="text-slate-300 text-lg mb-4">
                    High-resolution JPEG perfect for digital viewing, desktop wallpapers, or tablet reference while reading.
                  </p>
                  <a
                    href={getAssetUrl('images/ilyr-prime.jpg')}
                    download="ilyr-prime-map.jpg"
                    class="inline-flex items-center bg-emerald-600 hover:bg-emerald-700 text-white px-6 py-3 rounded-lg font-semibold transition-colors duration-200"
                  >
                    <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
                    </svg>
                    Download JPEG
                  </a>
                </div>
              </div>
            </div>

            <!-- Print Version (Coming Soon) -->
            <div class="mb-6">
              <div class="flex items-start mb-4">
                <span class="text-3xl mr-4">🖨️</span>
                <div class="flex-1">
                  <h4 class="text-xl font-semibold text-emerald-300 mb-2">Print Version <span class="text-sm text-slate-400">(Coming Soon)</span></h4>
                  <p class="text-slate-300 text-lg mb-4">
                    High-resolution PDF optimized for printing at various sizes. Perfect for book clubs, classroom discussions, or framing.
                  </p>
                  <button
                    disabled
                    class="inline-flex items-center bg-slate-700 text-slate-400 px-6 py-3 rounded-lg font-semibold cursor-not-allowed opacity-50"
                  >
                    <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                    </svg>
                    Coming Soon
                  </button>
                </div>
              </div>
            </div>
          </div>

          <!-- Usage Guidelines -->
          <div class="bg-emerald-900/20 p-6 rounded-lg border border-emerald-600/30">
            <h4 class="text-lg font-semibold text-emerald-300 mb-3 font-['Cinzel']">Usage Guidelines</h4>
            <p class="text-slate-300 text-lg">
              These maps are provided for <strong>personal, non-commercial use</strong>. Feel free to use them for:
            </p>
            <ul class="mt-3 space-y-2 text-slate-300 text-lg">
              <li>• Reference while reading the book</li>
              <li>• Book club discussions and study groups</li>
              <li>• Personal enjoyment and collection</li>
              <li>• Educational purposes</li>
            </ul>
            <p class="text-slate-400 text-sm mt-4 italic">
              For commercial use, derivative works, or other inquiries, please contact us.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Additional Resources Preview -->
  <section class="py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-3xl md:text-4xl font-bold text-emerald-400 mb-4 font-['Cinzel']">
          More Resources Coming Soon
        </h2>
        <p class="text-xl text-slate-300 max-w-3xl mx-auto mb-8">
          We're working on additional downloadable content to enhance your experience with The Secret Harmony.
        </p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
        <!-- Character Reference Guide -->
        <div class="bg-slate-900/50 p-8 rounded-lg border border-emerald-800/30 opacity-60">
          <div class="text-5xl mb-4">📖</div>
          <h3 class="text-xl font-semibold text-emerald-400 mb-3 font-['Cinzel']">Character Reference Guide</h3>
          <p class="text-slate-300 text-lg mb-4">
            Detailed profiles of major characters, their relationships, and development arcs.
          </p>
          <span class="text-sm text-slate-400 italic">Coming Soon</span>
        </div>

        <!-- Arbory Traditions Handbook -->
        <div class="bg-slate-900/50 p-8 rounded-lg border border-emerald-800/30 opacity-60">
          <div class="text-5xl mb-4">🌳</div>
          <h3 class="text-xl font-semibold text-emerald-400 mb-3 font-['Cinzel']">Arbory Traditions</h3>
          <p class="text-slate-300 text-lg mb-4">
            Deep dive into each of the Five Arbories: their histories, philosophies, and practices.
          </p>
          <span class="text-sm text-slate-400 italic">Coming Soon</span>
        </div>

        <!-- Harmonic System Guide -->
        <div class="bg-slate-900/50 p-8 rounded-lg border border-emerald-800/30 opacity-60">
          <div class="text-5xl mb-4">🎵</div>
          <h3 class="text-xl font-semibold text-emerald-400 mb-3 font-['Cinzel']">Harmonic System Guide</h3>
          <p class="text-slate-300 text-lg mb-4">
            Explore the magic system of I'lyr with examples and theoretical foundations.
          </p>
          <span class="text-sm text-slate-400 italic">Coming Soon</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Newsletter Signup -->
  <section class="py-20 bg-gradient-to-r from-emerald-900/50 to-slate-900/50">
    <div class="max-w-4xl mx-auto text-center px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl md:text-4xl font-bold text-emerald-400 mb-6 font-['Cinzel']">
        Get Notified About New Resources
      </h2>
      <p class="text-xl text-slate-300 mb-8">
        Join our newsletter to be the first to know when new maps, guides, and downloadable content become available.
      </p>

      <!-- Newsletter Signup Form -->
      <div class="max-w-md mx-auto">
        <script src="https://f.convertkit.com/ckjs/ck.5.js"></script>
        <form action="https://app.kit.com/forms/8429492/subscriptions" class="seva-form formkit-form" method="post" data-sv-form="8429492" data-uid="608c4688d4" data-format="inline" data-version="5" data-options="{&quot;settings&quot;:{&quot;after_subscribe&quot;:{&quot;action&quot;:&quot;message&quot;,&quot;success_message&quot;:&quot;Success! Now check your email to confirm your subscription.&quot;,&quot;redirect_url&quot;:&quot;&quot;},&quot;analytics&quot;:{&quot;google&quot;:null,&quot;fathom&quot;:null,&quot;facebook&quot;:null,&quot;segment&quot;:null,&quot;pinterest&quot;:null,&quot;sparkloop&quot;:null,&quot;googletagmanager&quot;:null},&quot;modal&quot;:{&quot;trigger&quot;:&quot;timer&quot;,&quot;scroll_percentage&quot;:null,&quot;timer&quot;:5,&quot;devices&quot;:&quot;all&quot;,&quot;show_once_every&quot;:15},&quot;powered_by&quot;:{&quot;show&quot;:true,&quot;url&quot;:&quot;https://kit.com/features/forms?utm_campaign=poweredby&amp;utm_content=form&amp;utm_medium=referral&amp;utm_source=dynamic&quot;},&quot;recaptcha&quot;:{&quot;enabled&quot;:false},&quot;return_visitor&quot;:{&quot;action&quot;:&quot;show&quot;,&quot;custom_content&quot;:&quot;&quot;},&quot;slide_in&quot;:{&quot;display_in&quot;:&quot;bottom_right&quot;,&quot;trigger&quot;:&quot;timer&quot;,&quot;scroll_percentage&quot;:null,&quot;timer&quot;:5,&quot;devices&quot;:&quot;all&quot;,&quot;show_once_every&quot;:15},&quot;sticky_bar&quot;:{&quot;display_in&quot;:&quot;top&quot;,&quot;trigger&quot;:&quot;timer&quot;,&quot;scroll_percentage&quot;:null,&quot;timer&quot;:5,&quot;devices&quot;:&quot;all&quot;,&quot;show_once_every&quot;:15}},&quot;version&quot;:&quot;5&quot;}" min-width="400 500 600 700 800">
          <div data-style="clean">
            <ul class="formkit-alert formkit-alert-error" data-element="errors" data-group="alert"></ul>
            <div data-element="fields" data-stacked="false" class="seva-fields formkit-fields">
              <div class="formkit-field">
                <input class="formkit-input-ilyr"
                      name="email_address"
                      aria-label="Email Address"
                      placeholder="Enter your email address"
                      required=""
                      type="email">
              </div>
              <button data-element="submit" class="formkit-submit formkit-submit">
                <div class="formkit-spinner"><div></div><div></div><div></div></div>
                <span class="">Join Newsletter</span>
              </button>
            </div>
            <div class="formkit-powered-by-convertkit-container">
              <a href="https://kit.com/features/forms?utm_campaign=poweredby&amp;utm_content=form&amp;utm_medium=referral&amp;utm_source=dynamic" data-element="powered-by" class="formkit-powered-by-convertkit" data-variant="dark" target="_blank" rel="nofollow">Built with Kit</a>
            </div>
          </div>
        </form>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* Kit form custom styling to match site theme */
  .formkit-form[data-uid="608c4688d4"] .formkit-input {
    background: rgba(30, 41, 59, 0.5) !important;
    border: 1px solid rgb(75, 85, 99) !important;
    border-radius: 0.5rem !important;
    color: white !important;
    padding: 0.5rem 1rem !important;
    font-size: 15px !important;
  }

  .formkit-form[data-uid="608c4688d4"] .formkit-input:focus {
    outline: none !important;
    border-color: rgb(16, 185, 129) !important;
    box-shadow: 0 0 0 2px rgba(16, 185, 129, 0.5) !important;
  }

  .formkit-form[data-uid="608c4688d4"] .formkit-input::placeholder {
    color: rgb(148, 163, 184) !important;
    opacity: 1 !important;
  }

  .formkit-form[data-uid="608c4688d4"] .formkit-submit {
    background-color: rgb(55, 65, 81) !important;
    border-radius: 0.5rem !important;
    color: white !important;
    font-weight: 500 !important;
    transition: background-color 0.2s !important;
    border: none !important;
    padding: 0.5rem 1.5rem !important;
  }

  .formkit-form[data-uid="608c4688d4"] .formkit-submit:hover {
    background-color: rgb(75, 85, 99) !important;
  }

  .formkit-form[data-uid="608c4688d4"] .formkit-fields {
    display: flex !important;
    flex-direction: column !important;
    gap: 0.5rem !important;
  }

  @media (min-width: 640px) {
    .formkit-form[data-uid="608c4688d4"] .formkit-fields {
      flex-direction: row !important;
    }

    .formkit-form[data-uid="608c4688d4"] .formkit-field {
      flex: 1 !important;
    }

    .formkit-form[data-uid="608c4688d4"] .formkit-submit {
      flex: none !important;
      white-space: nowrap !important;
    }
  }

  .formkit-form[data-uid="608c4688d4"] .formkit-powered-by-convertkit-container {
    display: none !important;
  }

  .formkit-form[data-uid="608c4688d4"] .formkit-alert-success {
    background: rgba(16, 185, 129, 0.1) !important;
    border-color: rgb(16, 185, 129) !important;
    color: rgb(16, 185, 129) !important;
    border-radius: 0.5rem !important;
  }

  .formkit-form[data-uid="608c4688d4"] .formkit-alert-error {
    background: rgba(239, 68, 68, 0.1) !important;
    border-color: rgb(239, 68, 68) !important;
    color: rgb(239, 68, 68) !important;
    border-radius: 0.5rem !important;
  }
</style>
